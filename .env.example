# Copy this file to .env.local and fill in real values
# Never commit .env.local to source control

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Cookie name used to store the JWT token
# This is set server-side by the /api/auth/login route handler
AUTH_COOKIE_NAME=medibill_token

# JWT secret — must match the backend JWT_SECRET
# Only used server-side in route handlers / middleware, not exposed to browser
JWT_SECRET=change_me_to_match_backend_secret
